@startuml
!include <C4/C4_Context>

Person(customer, "Клиент", "Пользователь интернет-банка или сайта")

System_Boundary(standardBank, "Информационная система банка «Стандарт»") {
    System(website, "Сайт", "Подача заявки на депозит для новых клиентов")
    System(internetBank, "Интернет-банк", "Оформление депозитов авторизованными клиентами")
    System(depositService, "Сервис заявок на депозит", "Обработка и маршрутизация заявок")
    System(abs, "АБС", "Обработка заявок и расчёт ставок")
    System(smsGateway, "СМС-шлюз", "Отправка уведомлений клиенту")
}

System_Ext(telecomProvider, "Телеком-оператор", "Отправка SMS клиентам")

Rel(customer, website, "Просмотр и подача заявки", "HTTPS")
Rel(customer, internetBank, "Оформление депозита", "HTTPS + SMS")

Rel(website, depositService, "REST API")
Rel(internetBank, depositService, "REST API")

Rel(depositService, abs, "Передача заявки", "Kafka")
Rel(abs, smsGateway, "Отправка СМС", "REST API")
Rel(smsGateway, telecomProvider, "Пересылка SMS", "HTTPS")
Rel(telecomProvider, customer, "СМС-уведомление", "SMS")
@enduml
